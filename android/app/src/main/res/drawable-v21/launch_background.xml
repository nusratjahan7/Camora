<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen (Android 11 and below): ink background with the Veylora mark,
     so a dark app never flashes white on start. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/veylora_ink" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
